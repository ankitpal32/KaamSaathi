# ==============================================================================
# KaamSaathi Frontend Environment Configuration
# Copy this file to .env in frontend/ directory for local development.
# Only client-safe variables prefixed with VITE_ are permitted here!
# NEVER put secret service keys, database passwords, or Bolna API keys here.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Bolna WebRTC Voice Session URL (routed through backend proxy to protect API keys)
VITE_BOLNA_SESSION_URL=/api/bolna-session

# Optional, only if the frontend directly uses Supabase:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
