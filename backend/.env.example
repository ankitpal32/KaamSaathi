# ==============================================================================
# KaamSaathi Backend Environment Variables
# Copy this file to .env in backend/ and fill in your actual values.
# NEVER commit the real .env file into version control!
# ==============================================================================

# Supabase Credentials (Found in Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# Bolna Voice Assistant Configuration
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (Comma-separated for local frontend dev)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
